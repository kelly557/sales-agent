{
  "name": "doctech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 2288 --strictPort",
    "dev:local": "vite --host 0.0.0.0 --port 2299 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 2288 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "install-hooks": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "harness": "node scripts/harness-check.mjs",
    "harness:staged": "node scripts/harness-check.mjs --staged",
    "quality": "npm run lint && npm run typecheck && npm run harness && npm run build"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.26.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5"
  }
}
